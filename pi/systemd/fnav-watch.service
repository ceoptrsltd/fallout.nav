[Unit]
Description=fallout.nav alarm vision (fnav-watch: people at the van, front and rear cameras)
Documentation=file:///opt/fnav/app/docs/contracts/vision.md
# Ordering only: frames come from fnav-camera through /dev/shm/fnav-lores and, when the rear camera is on, from
# fnav-camera-rear through /dev/shm/fnav-lores-rear; any side may restart on its own, and a crash here never touches
# recording (fnav-camera*) or the alarm itself (fnav-core). One process and one inference thread for both cameras.
After=fnav-camera.service fnav-camera-rear.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=fnav
Group=fnav
WorkingDirectory=/opt/fnav/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPYCACHEPREFIX=/var/cache/fnav/pycache
Environment=FNAV_DATA_DIR=/var/lib/fnav
# One inference thread: OpenCV is told so in code, these cover OpenMP/OpenBLAS inside the wheels.
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/fnav/venv/bin/python -m fnav.watch
Restart=always
RestartSec=5
TimeoutStopSec=10

# While armed this service IS the alarm, so it must get its core even when the screen is busy: with SCHED_IDLE
# (the old setting) the rear view on the screen while armed (Chromium ~2 cores) starved NanoDet to 1.3-1.5 s a
# frame and no rule could fire (01.11). It works only while armed (disarmed it sleeps, ~0.3 % of a core), so a
# priority above the screen costs nothing on the road. One inference thread; recording keeps its Nice -5.
# No CPUQuota: a quota would only add stalls.
CPUWeight=200
Nice=0
IOSchedulingClass=best-effort
IOSchedulingPriority=7
OOMScoreAdjust=500
MemoryHigh=300M
MemoryMax=400M
TasksMax=64

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/var/cache/fnav/pycache
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
