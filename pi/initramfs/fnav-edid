#!/bin/sh
# fallout.nav: put the EDID into the initramfs (needed only if vc4 is loaded from the initramfs).
# Installed as /etc/initramfs-tools/hooks/fnav-edid.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
. /usr/share/initramfs-tools/hook-functions
[ -f /lib/firmware/edid/fnav-576p50.bin ] && copy_file firmware /lib/firmware/edid/fnav-576p50.bin /lib/firmware/edid/fnav-576p50.bin
exit 0
