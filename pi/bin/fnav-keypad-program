#!/bin/bash
# Program the 6-key macro pad with a knob (USB 1189:8890) with pi/keypad/fnav-keypad.yaml (F13-F21 + Enter,
# see fnav/core/keypad.py). Builds ch57x-keyboard-tool 1.7.0 once (1.8.0 needs a newer Rust than Debian's
# 1.85) into /opt/fnav/tools. Run as root with the pad plugged in.
# LEDs: the stock firmware has only modes 0 off, 1 light on press then flicker, 2 running lights
# (3+ just light one key); no per-key or host-driven colours. FNAV_KEYPAD_LED (default 0) picks one.
set -euo pipefail
TOOL=/opt/fnav/tools/ch57x-keyboard-tool
CFG="${1:-/opt/fnav/app/pi/keypad/fnav-keypad.yaml}"
if [ ! -x "$TOOL" ]; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends cargo rustc libusb-1.0-0-dev pkg-config >/dev/null
    ROOT="$(mktemp -d /var/tmp/ch57x.XXXXXX)"
    trap 'rm -rf "$ROOT"' EXIT
    nice -n 10 cargo install --quiet --root "$ROOT" ch57x-keyboard-tool@1.7.0 -j 3
    install -d -m 0755 /opt/fnav/tools
    install -m 0755 "$ROOT/bin/ch57x-keyboard-tool" "$TOOL"
fi
lsusb -d 1189:8890 >/dev/null || { echo "the macro pad (1189:8890) is not plugged in" >&2; exit 1; }
"$TOOL" validate "$CFG"
"$TOOL" upload "$CFG"
"$TOOL" led "${FNAV_KEYPAD_LED:-0}"
echo "macro pad programmed from $CFG, LED mode ${FNAV_KEYPAD_LED:-0}"
