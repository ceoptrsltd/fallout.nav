#!/bin/bash
# Runs inside cage (fnav-games.service, user fnav): mirror the output like the navigation screen does
# (display.mirror_x - the reversing monitor shows the picture mirrored), then the game from
# /run/fnav-core/game.args, written by fnav-core: line 1 "retroarch" (then libretro core, game file) or
# "native" (then the program and its arguments, one per line).
set -u
ARGS=/run/fnav-core/game.args
CFG_DIR=/var/lib/fnav/retroarch
mapfile -t A < "$ARGS" || { echo "no $ARGS" >&2; exit 1; }
KIND="${A[0]:-}"

if python3 -I -c 'import json, sys; s = json.load(open("/var/lib/fnav/settings.json")); sys.exit(0 if s.get("display", {}).get("mirror_x") else 1)' 2>/dev/null; then
    wlr-randr --output Composite-1 --transform flipped || echo "wlr-randr: mirror failed" >&2
fi

case "$KIND" in
retroarch)
    CORE="${A[1]:-}"
    CONTENT="${A[2]:-}"
    [ -f "$CORE" ] && [ -f "$CONTENT" ] || { echo "bad game args: $CORE $CONTENT" >&2; exit 1; }
    mkdir -p "$CFG_DIR" /var/lib/fnav/games/saves /var/lib/fnav/games/states
    # Our settings as the whole config, written on every start (--appendconfig over an empty file is ignored by
    # RetroArch 1.20, and then the gamepad profile is not found); nothing is saved back on exit.
    cp /opt/fnav/app/pi/games/retroarch-fnav.cfg "$CFG_DIR/retroarch.cfg"
    # shellcheck disable=SC2086  # FNAV_RETROARCH_EXTRA: extra flags for debugging, e.g. --verbose
    exec retroarch --config "$CFG_DIR/retroarch.cfg" ${FNAV_RETROARCH_EXTRA:-} -L "$CORE" "$CONTENT"
    ;;
native)
    [ -x "${A[1]:-}" ] || { echo "not executable: ${A[1]:-}" >&2; exit 1; }
    # SDL games: Wayland (cage), our gamepad as an SDL game controller, sound to the Bluetooth speaker
    export SDL_VIDEODRIVER=wayland
    export SDL_AUDIODRIVER=alsa
    export AUDIODEV=bluealsa
    SDL_GAMECONTROLLERCONFIG="$(grep -v "^#" /opt/fnav/app/pi/games/sdl_gamecontrollerdb.txt 2>/dev/null)"
    export SDL_GAMECONTROLLERCONFIG
    # each native game works in its own writable directory (config, saves, caches; EDuke32 with -usecwd),
    # seeded once with our defaults from pi/games/<program>/ (resolution, renderer)
    base="$(basename "${A[1]}")"
    mkdir -p "/var/lib/fnav/games/$base"
    cd "/var/lib/fnav/games/$base" || exit 1
    if [ -d "/opt/fnav/app/pi/games/$base" ]; then
        cp -n "/opt/fnav/app/pi/games/$base/"* . 2>/dev/null || true
    fi
    exec "${A[@]:1}"
    ;;
*)
    echo "unknown game kind: $KIND" >&2
    exit 1
    ;;
esac
