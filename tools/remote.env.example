# Copy to tools/.remote.env (not in git) and fill in. Used by tools/remote.sh.
# ssh login with root rights on the server that hosts the public site
REMOTE_SSH=root@server.example.com
# private key for REMOTE_SSH (optional; ssh-agent / ~/.ssh/config work too)
REMOTE_SSH_KEY=~/.ssh/id_ed25519
# public host name: the admin is at https://$REMOTE_SITE/fnadmin/; the device's tunnel connects here too
REMOTE_SITE=example.com
# nginx site file of that host (its HTTPS server block gets "include snippets/fnadmin.conf;")
REMOTE_SITE_FILE=/etc/nginx/sites-available/example.com
# device ssh alias or address
FNAV_HOST=fnav
# optional: tunnel user and sshd port on the server
#REMOTE_TUNNEL_USER=fnavtun
#REMOTE_TUNNEL_PORT=22
